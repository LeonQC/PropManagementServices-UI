# Copy to .env to override. .env is gitignored; this file documents the knobs.

# Which backend handles KEYWORD search on the listings grid.
#   search   (default) — OpenSearch via search-service on :5600. Typo tolerance,
#                        prefix matching, and relevance ranking.
#   listings           — Postgres full-text on :5100. Use when running without the
#                        OpenSearch stack.
#
# This only affects requests that carry a keyword. Plain browsing of the grid —
# filtering, sorting, pagination — always goes to /listings/v1, so the default view
# never depends on the search stack being up.
#
# Even on "search", a keyword request falls back to Postgres full-text automatically
# if search-service is unreachable.
VITE_SEARCH_API=search
