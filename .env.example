# Copy to .env to override. .env is gitignored; this file documents the knobs.

# Which backend handles KEYWORD search on the listings grid and the deal board.
#   search   (default) — OpenSearch via search-service on :5600. Typo tolerance,
#                        prefix matching, and relevance ranking.
#   listings           — Postgres full-text on :5100 (properties) and :5200 (deals).
#                        Use when running without the OpenSearch stack.
#
# This only affects requests that carry a keyword. Plain browsing — filtering, sorting,
# pagination — always goes to the owning service, so the default views never depend on
# the search stack being up.
#
# Even on "search", a keyword request falls back to Postgres full-text automatically
# if search-service is unreachable.
VITE_SEARCH_API=search
